{URI} {
	tls {EMAIL}

	# WebSocket path -> V2Ray (TLS is terminated here, plain ws to upstream).
	# Caddy v2 reverse_proxy auto-detects and forwards WebSocket upgrades.
	handle /{PATH} {
		reverse_proxy v2ray:{PORT} {
			header_up -Origin
		}
	}

	# Everything else: behave like an ordinary website (camouflage).
	handle {
		respond "Hello, world!" 200
	}
}
