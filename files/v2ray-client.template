{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 10808,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": true,
        "auth": "noauth"
      },
      "tag": "socks_main",
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    },
    {
      "port": 10809,
      "listen": "127.0.0.1",
      "protocol": "http",
      "settings": {
        "timeout": 300
      },
      "tag": "http_main",
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{URI}",
            "port": 443,
            "users": [
              {
                "id": "{UUID}",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "tag": "vless_main",
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "{URI}"
        },
        "wsSettings": {
          "path": "/{PATH}",
          "headers": {
            "Host": "{URI}"
          }
        }
      },
      "mux": {
        "enabled": false
      }
    }
  ]
}
