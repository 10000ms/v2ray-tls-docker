{
  "log": {
    "access": "/var/log/v2ray/access.log",
    "error": "/var/log/v2ray/error.log",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 8001,
      "listen": "0.0.0.0",
      "protocol": "http",
      "settings": {
        "timeout": 300,
        "accounts": []
      },
      "tag": "http_main",
      "sniffing": {
        "enabled": false,
        "destOverride": ["http", "tls"]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{URI}",
            "port": 443,
            "users": [
              {
                "id": "{UUID}",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "tag": "vless_main",
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "{URI}"
        },
        "wsSettings": {
          "path": "/{PATH}",
          "headers": {
            "Host": "{URI}"
          }
        }
      },
      "mux": {
        "enabled": false
      }
    }
  ]
}
